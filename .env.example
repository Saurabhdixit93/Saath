# ==============================================================================
# Saath — Environment Configuration Example
# Copy to .env for local development. Never commit real production secrets.
# ==============================================================================

# --- Core / Runtime ---
ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=saath-api
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# --- Database & Redis ---
DATABASE_URL=postgresql+asyncpg://saath:saath@127.0.0.1:5432/saath
DATABASE_READ_URL=
REDIS_URL=redis://127.0.0.1:6379/0

# --- Cryptography & Auth ---
# Leave JWT_PRIVATE_KEY / JWT_PUBLIC_KEY empty in ENV=development to auto-generate
# an ephemeral dev Ed25519 keypair, or run `make seed` / set PEM strings (\n escaped).
# Mandatory in ENV=production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SECONDS=900
JWT_ANON_TTL_SECONDS=7200
REFRESH_TOKEN_TTL_DAYS=30
PNR_PEPPER=dev-pnr-pepper-change-in-production-32b
PHONE_AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PHONE_BLIND_INDEX_KEY=YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODk=
SWAP_CARD_SIGNING_PRIVATE_KEY=
SWAP_CARD_SIGNING_PUBLIC_KEY=
INVITE_TOKEN_SECRET=dev-invite-token-secret-change-in-production

# --- Cloudflare Turnstile ---
# TURNSTILE_MODE=fake is forbidden when ENV=production.
TURNSTILE_MODE=fake
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rail Data Providers (M2+) ---
RAIL_PROVIDER_MODE=fake
PROVIDER_RAIL_A_BASE_URL=
PROVIDER_RAIL_A_API_KEY=
PROVIDER_RAIL_B_BASE_URL=
PROVIDER_RAIL_B_API_KEY=
PROVIDER_RAIL_TIMEOUT_MS=3000

# --- Flight Schedule Provider (M2+) ---
FLIGHT_PROVIDER_MODE=fake
PROVIDER_FLIGHT_BASE_URL=
PROVIDER_FLIGHT_API_KEY=

# --- WhatsApp Cloud API ---
WHATSAPP_MODE=fake
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# --- SMS (MSG91) ---
SMS_MODE=fake
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SAATHI
MSG91_DLT_TE_ID_OTP=
MSG91_DLT_TE_ID_NOTIFY=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@saath.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Anthropic / Claude AI (M5+) ---
AI_MODE=fake
ANTHROPIC_API_KEY=
ANTHROPIC_CONCIERGE_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- Payments / Billing (R3, M2+) ---
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Admin SSO (M5+) ---
ADMIN_SSO_CLIENT_ID=
ADMIN_SSO_CLIENT_SECRET=
ADMIN_SSO_ALLOWED_EMAILS=

# --- Frontend Public Vars ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1/ws
NEXT_PUBLIC_TURNSTILE_MODE=fake
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_SSO_ENABLED=false
